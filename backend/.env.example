# Copy to .env (do not commit .env). Railway: set these in the service Variables tab.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
PORT=5001
NODE_ENV=development

# Optional: used by the 14-minute cron in production to ping this API (wake / keep warm).
# On Railway set to your public URL, e.g. https://YOUR-SERVICE.up.railway.app/api
API_URL=
