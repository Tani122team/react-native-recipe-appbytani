# Copy to .env (do not commit .env). Restart Expo after any change.
# Clerk → API Keys → Publishable key (pk_test_… or pk_live_…)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Optional: hosted API (Railway). For a real phone, set this to your HTTPS URL ( /api is added if missing ).
EXPO_PUBLIC_API_URL=https://your-service.up.railway.app
